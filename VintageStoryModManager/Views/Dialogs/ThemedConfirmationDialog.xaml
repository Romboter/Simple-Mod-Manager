<Window x:Class="VintageStoryModManager.Views.Dialogs.ThemedConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmation" Height="220" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource Brush.Panel.Primary.Background.Solid}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock VerticalAlignment="Top" Margin="0,2,10,0">
                <TextBlock.Text>
                    <!-- Unicode warning icon, or replace with an Image if you have a resource -->
                    ⚠️
                </TextBlock.Text>
            </TextBlock>
            <TextBlock x:Name="TitleText" Text="Confirm Deletion" FontWeight="Bold" FontSize="18"/>
        </StackPanel>
        <TextBlock x:Name="MessageText" Grid.Row="1" TextWrapping="Wrap" FontSize="14"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Delete" Width="90" Margin="0,0,10,0" IsDefault="True" Click="Yes_Click"/>
            <Button Content="Cancel" Width="90" IsCancel="True" Click="No_Click"/>
        </StackPanel>
    </Grid>
</Window>
