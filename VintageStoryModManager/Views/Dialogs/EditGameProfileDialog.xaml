<Window x:Class="VintageStoryModManager.Views.Dialogs.EditGameProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Game Profile"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Panel.Primary.Background.Solid}"
        Loaded="Window_OnLoaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Profile name (read-only) -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Profile Name"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       FontSize="12"
                       Margin="0,0,0,4" />
            <TextBlock x:Name="ProfileNameText"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Primary}" />
        </StackPanel>

        <!-- Profile Type (hidden when server options disabled) -->
        <StackPanel x:Name="ProfileTypeSection" Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="Profile Type"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="LocalRadio"
                             Content="Local"
                             IsChecked="True"
                             Foreground="{DynamicResource Brush.Text.Primary}"
                             Checked="ProfileType_Changed"
                             Margin="0,0,16,0" />
                <RadioButton x:Name="ServerRadio"
                             Content="Server"
                             Foreground="{DynamicResource Brush.Text.Primary}"
                             Checked="ProfileType_Changed" />
            </StackPanel>
        </StackPanel>

        <!-- Server Target Selection (only visible for Server profiles) -->
        <StackPanel x:Name="ServerTargetPanel"
                    Grid.Row="2"
                    Margin="0,16,0,0"
                    Visibility="Collapsed">
            <TextBlock Text="Server Target"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       Margin="0,0,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ServerTargetCombo"
                          DisplayMemberPath="Name"
                          SelectionChanged="ServerTargetCombo_SelectionChanged" />
                <Button Grid.Column="1"
                        Content="Manage..."
                        Padding="12,4"
                        Margin="8,0,0,0"
                        Click="ManageTargets_Click" />
            </Grid>
            <TextBlock x:Name="NoTargetsWarning"
                       Text="No server targets configured. Click 'Manage...' to add one."
                       Foreground="#FFA500"
                       FontSize="11"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,24,0,0">
            <Button x:Name="SaveButton"
                    Width="90"
                    Margin="0,0,8,0"
                    Content="Save"
                    IsDefault="True"
                    Click="SaveButton_OnClick" />
            <Button Width="90"
                    Content="Cancel"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
