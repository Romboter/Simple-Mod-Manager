<Window x:Class="VintageStoryModManager.Views.Dialogs.ServerTargetEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VintageStoryModManager.Views.Dialogs"
        Title="{Binding Title}"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window.Shell.Background.Solid}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanConverter x:Key="InverseBoolConverter" />
        <local:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
    </Window.Resources>

    <Grid Margin="20"
          Background="{DynamicResource Brush.Panel.Primary.Background.Solid}"
          TextElement.Foreground="{DynamicResource Brush.Text.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Form fields -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Name" Margin="0,0,0,4" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12" />

            <TextBlock Text="Host" Margin="0,0,0,4" />
            <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Username" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Port" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Authentication" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding AuthTypes}"
                      SelectedItem="{Binding AuthType}"
                      Margin="0,0,0,12" />

            <!-- Password auth -->
            <StackPanel Visibility="{Binding IsPasswordAuth, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Password" Margin="0,0,0,4" />
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,12" PasswordChanged="PasswordBox_PasswordChanged" />
            </StackPanel>

            <!-- Private key auth -->
            <StackPanel Visibility="{Binding IsPrivateKeyAuth, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Private Key File" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding PrivateKeyPath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowsePrivateKeyCommand}" Margin="8,0,0,0" Padding="12,4" />
                </Grid>

                <TextBlock Text="Key Passphrase (if any)" Margin="0,0,0,4" />
                <PasswordBox x:Name="PassphraseBox" Margin="0,0,0,12" PasswordChanged="PassphraseBox_PasswordChanged" />
            </StackPanel>

            <TextBlock Text="Remote Data Path" Margin="0,0,0,4" />
            <TextBox Text="{Binding RemoteDataPath, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,4" />
            <TextBlock Text="e.g., /home/user/vintagestory/data or /srv/vintagestory"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       FontSize="11"
                       Margin="0,0,0,12" />

            <CheckBox Content="Remember credentials"
                      IsChecked="{Binding RememberCredentials}"
                      Margin="0,0,0,12" />
        </StackPanel>

        <!-- Test connection section -->
        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Panel.Secondary.Background.Solid}"
                Padding="12"
                Margin="0,0,0,16">
            <StackPanel>
                <Button Content="Test Connection"
                        Command="{Binding TestConnectionCommand}"
                        IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBoolConverter}}"
                        Padding="12,6"
                        HorizontalAlignment="Left" />
                <TextBlock Text="{Binding TestResult}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Top"
                           MaxWidth="400" />
            </StackPanel>
        </Border>

        <!-- Validation error -->
        <TextBlock Grid.Row="1"
                   Text="{Binding ValidationError}"
                   Foreground="#FF6B6B"
                   Visibility="{Binding ValidationError, Converter={StaticResource NullToCollapsedConverter}}"
                   Margin="0,8,0,0" />

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Click="SaveButton_Click" IsDefault="True" Padding="16,8" Margin="0,0,8,0" />
            <Button Content="Cancel" Click="CancelButton_Click" IsCancel="True" Padding="16,8" />
        </StackPanel>
    </Grid>
</Window>
